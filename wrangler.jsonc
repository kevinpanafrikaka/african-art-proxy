{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "african-art-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "african_art_db",
      "database_id": "36630439-eebb-4100-80df-8d2ff7ca03a6"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
